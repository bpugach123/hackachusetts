{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sentiment.json",
  "description": "(Stretch) Tier 3 narrative notes for top-5 cells, keyed by cell_id. Text only; never read by any score function (Req 3.6, 3.7, 14.7). See docs/schema.md.",
  "type": "object",
  "propertyNames": { "pattern": "^C[0-9]+-[0-9]{4,}-[0-9]{4,}$" },
  "additionalProperties": { "$ref": "#/$defs/Note" },
  "$defs": {
    "Note": {
      "type": "object",
      "required": ["note", "citations"],
      "additionalProperties": false,
      "properties": {
        "note": { "type": "string", "minLength": 1 },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/NarrativeCitation" }
        }
      }
    },
    "NarrativeCitation": {
      "type": "object",
      "required": ["agency", "title", "url", "date"],
      "additionalProperties": false,
      "properties": {
        "agency": { "type": "string", "minLength": 1, "description": "Publisher, agency, or docket owner." },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  }
}
